{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Ledger",
  "type": "object",
  "required": ["project", "evidence"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "domain"],
      "properties": {
        "name": {"type": "string"},
        "domain": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "patternProperties": {
        "^E[0-9]+$": {
          "type": "object",
          "required": ["type", "source", "experiment", "metrics", "scope", "verified"],
          "properties": {
            "type": {"type": "string", "enum": ["simulation_result", "sil_result", "hil_result", "physical_result", "analytical"]},
            "source": {
              "type": "object",
              "required": ["file"],
              "properties": {
                "file": {"type": "string"},
                "commit": {"oneOf": [{"type": "null"}, {"type": "string"}]}
              }
            },
            "experiment": {
              "type": "object",
              "required": ["id"],
              "properties": {"id": {"type": "string"}}
            },
            "evidence_level": {"type": "string", "enum": ["L0","L1","L2","L3","L4","L5","L6"]},
            "metrics": {"type": "object"},
            "scope": {
              "type": "object",
              "properties": {
                "environment": {"type": "string"},
                "trials": {"type": "integer", "minimum": 1},
                "seeds": {"type": "integer"}
              }
            },
            "verified": {"type": "boolean"}
          }
        }
      }
    }
  }
}
